---
/** An Iconaut icon (MIT; vendored by tools/icons.py into src/icons), inline, in the text's colour. */
interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const files = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const svg = (files[`../icons/${name}.svg`] ?? '')
  .replace(/width="24" height="24"/, `width="${size}" height="${size}" aria-hidden="true" focusable="false"${cls ? ` class="${cls}"` : ''}`);
---
<Fragment set:html={svg} />
