---
import Base from '../../layouts/Base.astro';
import GetApp from '../../components/GetApp.astro';
import { game } from '../../lib/game';
const c = game.counts;
---
<Base title="Guide" description={`The Tales of Dorlune guide: a beginner's guide, a walkthrough, where to level, and every monster, land, quest, item and skill in the game.`} crumbs={[{ name: 'Guide' }]}>
  <div class="card">
    <h1>The guide</h1>
    <p class="lead">Everything in Tales of Dorlune, looked up. It's built from the game's own files, so the numbers are the ones the game uses.</p>
    <h2>New to Dorlune?</h2>
    <div class="grid">
      <a class="tile" href="/guide/start/"><div><strong>Start here</strong><span>Your first hour: the egg, your first fights and your first friend</span></div></a>
      <a class="tile" href="/guide/walkthrough/"><div><strong>Walkthrough</strong><span>Land by land, from level 1 to {c.maxLevel}</span></div></a>
      <a class="tile" href="/guide/leveling/"><div><strong>Where to level</strong><span>The right land for your level</span></div></a>
    </div>
    <h2>Look it up</h2>
    <div class="grid">
      <a class="tile" href="/monsters/"><div><strong>Monsters</strong><span>{c.monsters} in the Monster Book</span></div></a>
      <a class="tile" href="/monsters/?kind=boss"><div><strong>Bosses</strong><span>{c.bosses} out of the fairy tales</span></div></a>
      <a class="tile" href="/lands/"><div><strong>Lands</strong><span>{c.lands} lands, {c.towns} towns and the world map</span></div></a>
      <a class="tile" href="/quests/"><div><strong>Quests</strong><span>{c.quests} quests and their rewards</span></div></a>
      <a class="tile" href="/items/"><div><strong>Items</strong><span>{c.items} weapons, armour, potions and materials</span></div></a>
      <a class="tile" href="/classes/"><div><strong>Classes</strong><span>Fighter, Mage and Beast Tamer</span></div></a>
      <a class="tile" href="/skills/"><div><strong>Skills</strong><span>{c.skills} skills and spells</span></div></a>
      <a class="tile" href="/guide/elements/"><div><strong>Elements</strong><span>What beats what</span></div></a>
    </div>
  </div>
  <div style="margin-top:22px"><GetApp compact /></div>
</Base>
