---
import Base from '../../layouts/Base.astro';
import GetApp from '../../components/GetApp.astro';
import { game, wildLands, levels, num, expToNext, expAt } from '../../lib/game';
const mon = (slug: string) => game.monsters.find((m: any) => m.slug === slug);
/** The EXP an average fight's monster gives in a land, at the middle of its levels. */
const typical = (l: any) => {
  const mid = Math.round((l.levels[0] + l.levels[1]) / 2);
  return Math.round(l.monsters.reduce((sum: number, m: any) => sum + m.share * expAt(mon(m.slug), mid), 0));
};
const marks = [1, 5, 10, 20, 30, 40, 50, 60, 80, 100, 120, 140, 160, 180, 199];
const total = (to: number) => { let t = 0; for (let l = 1; l < to; l++) t += expToNext(l); return t; };
---
<Base title="Where to level: the right land for your level" description={`Where to level up in Tales of Dorlune from level 1 to ${game.counts.maxLevel}: every land's level range, its boss, and how much EXP each level takes.`} crumbs={[{ name: 'Guide', href: '/guide/' }, { name: 'Where to level' }]}>
  <div class="card">
    <h1>Where to level</h1>
    <p class="lead">Fight in the land whose levels match yours. Its monsters give the most EXP you can safely earn, and its quests pay far more than the fights do.</p>
    <div class="note">Stuck? Do the land's quests first: a quest often pays more EXP than a dozen fights. And daily bounties pay by your own level, so they're worth doing at any point.</div>
    <h2>Land by level</h2>
    <div class="table-wrap"><table class="cards">
      <thead><tr><th>Your level</th><th>Land</th><th>Boss</th><th class="n">EXP a monster</th><th class="n">Quests</th></tr></thead>
      <tbody>{wildLands.map((l: any) => (
        <tr>
          <td><strong>{levels(l.levels)}</strong></td>
          <td data-label="Land"><a href={`/lands/${l.slug}/`}>{l.name}</a></td>
          <td data-label="Boss">{l.bosses.length ? l.bosses.map((b: any) => <><a href={`/monsters/${b.slug}/`}>{b.name}</a> (Lv {b.level})</>) : '—'}</td>
          <td class="n" data-label="EXP a monster">about {num(typical(l))}</td>
          <td class="n" data-label="Quests">{game.quests.filter((q: any) => q.land?.slug === l.slug).length}</td>
        </tr>
      ))}</tbody>
    </table></div>
    <p class="small">EXP a monster is the average for the land's mix of monsters at the middle of its levels. A monster gives more the higher its level.</p>

    <h2>How much EXP a level takes</h2>
    <p>Each level takes more than the last, and past level 100 the climb steepens: by level 140 a level takes twice what it would have.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Level</th><th class="n">EXP to the next</th><th class="n">EXP so far</th></tr></thead>
      <tbody>{marks.map((l) => <tr><td>{l}</td><td class="n">{num(expToNext(l))}</td><td class="n">{num(total(l))}</td></tr>)}</tbody>
    </table></div>
    <p>Level {game.counts.maxLevel} is the top. Elder Oak in Meadowbrook has something to show for it.</p>
  </div>
  <div style="margin-top:22px"><GetApp compact /></div>
</Base>
